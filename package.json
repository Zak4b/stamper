{
	"name": "pdf-stamper-electron",
	"private": true,
	"version": "1.0.0",
	"main": "dist-electron/main.js",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build && electron-builder",
		"build:win": "npm run typecheck && vite build && electron-builder --win",
		"build:mac": "npm run typecheck && vite build && electron-builder --mac",
		"build:linux": "npm run typecheck && vite build && electron-builder --linux",
		"build:dir": "npm run typecheck && vite build && electron-builder --dir",
		"lint": "eslint .",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.app.json",
		"postinstall": "electron-rebuild -f -w better-sqlite3"
	},
	"dependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"better-sqlite3": "^12.6.0",
		"jszip": "^3.10.1",
		"lucide-react": "^0.562.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.4.149",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tesseract.js": "^7.0.0"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.0.2",
		"@eslint/js": "^9.9.1",
		"@types/node": "^25.0.8",
		"@types/react": "^18.3.5",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "^5.1.2",
		"autoprefixer": "^10.4.18",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"electron": "^40.0.0",
		"electron-builder": "^26.4.0",
		"electron-rebuild": "^3.2.9",
		"eslint": "^9.9.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.11",
		"globals": "^15.9.0",
		"postcss": "^8.4.35",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.5.3",
		"typescript-eslint": "^8.3.0",
		"vite": "^7.1.9",
		"vite-plugin-electron": "^0.29.0",
		"vite-plugin-electron-renderer": "^0.14.6",
		"vite-plugin-static-copy": "^3.1.3"
	},
	"overrides": {
		"tar": "^7.5.6"
	}
}
