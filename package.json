{
	"name": "pdf-stamper-electron",
	"private": true,
	"version": "1.3.0",
	"main": "dist-electron/main.js",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build && electron-builder",
		"build:win": "npm run typecheck && vite build && electron-builder --win",
		"publish:win": "npm run typecheck && vite build && electron-builder --win --publish always",
		"build:mac": "npm run typecheck && vite build && electron-builder --mac",
		"build:linux": "npm run typecheck && vite build && electron-builder --linux",
		"build:dir": "npm run typecheck && vite build && electron-builder --dir",
		"lint": "eslint .",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.app.json",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"better-sqlite3": "^12.6.2",
		"daisyui": "^5.6.14",
		"electron-updater": "^6.8.3",
		"jszip": "^3.10.1",
		"lucide-react": "^0.577.0",
		"papaparse": "^5.5.3",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.4.530",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tesseract.js": "^7.0.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^25.0.10",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"autoprefixer": "^10.4.27",
		"electron": "^40.0.0",
		"electron-builder": "^26.4.0",
		"eslint": "^9.39.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^17.1.0",
		"postcss": "^8.5.8",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vite": "^7.3.1",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.6",
		"vite-plugin-static-copy": "^3.1.6"
	}
}
